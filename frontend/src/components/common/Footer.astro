---
import { ArrowUpRight } from "lucide-react";
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-border bg-background">
  <div class="grid grid-cols-12 gap-6 px-6 py-12 lg:py-16">
    <!-- Legal & Elsewhere -->
    <div class="col-span-12 md:col-span-6 lg:col-span-4 flex flex-col gap-10">
      <div>
        <div class="micro-label text-muted-foreground mb-4">Legal</div>
        <ul class="space-y-2">
          <li>
            <a class="text-sm text-foreground hover:text-accent transition-colors" href="/catalog">Imprint</a>
          </li>
          <li>
            <a class="text-sm text-foreground hover:text-accent transition-colors" href="/catalog">Privacy</a>
          </li>
          <li>
            <a class="text-sm text-foreground hover:text-accent transition-colors" href="/catalog">Returns</a>
          </li>
          <li>
            <a class="text-sm text-foreground hover:text-accent transition-colors" href="/catalog">Contact</a>
          </li>
        </ul>
      </div>
      <div>
        <div class="micro-label text-muted-foreground mb-4">Elsewhere</div>
        <ul class="space-y-2">
          <li>
            <a
              href="https://www.instagram.com"
              target="_blank"
              rel="noreferrer"
              class="text-sm text-foreground hover:text-accent transition-colors inline-flex items-center gap-1"
            >
              <span>Instagram</span>
              <ArrowUpRight class="h-3 w-3" />
            </a>
          </li>
          <li>
            <a
              href="https://www.are.na"
              target="_blank"
              rel="noreferrer"
              class="text-sm text-foreground hover:text-accent transition-colors inline-flex items-center gap-1"
            >
              <span>Are.na</span>
              <ArrowUpRight class="h-3 w-3" />
            </a>
          </li>
          <li>
            <a
              href="/catalog"
              class="text-sm text-foreground hover:text-accent transition-colors inline-flex items-center gap-1"
            >
              <span>Newsletter</span>
              <ArrowUpRight class="h-3 w-3" />
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Monthly Letter -->
    <div class="col-span-12 md:col-span-6 lg:col-span-5 lg:col-start-6 md:border-l border-border md:pl-6">
      <div class="micro-label text-muted-foreground mb-4">Letter</div>
      <p class="font-display text-xl lg:text-2xl leading-tight tracking-tighter-1 mb-6 max-w-md">
        A monthly letter on form, material and the discipline of restraint.
      </p>
      <form class="flex border border-border max-w-md" onsubmit="event.preventDefault(); alert('Subscribed to Afetto Letter.');">
        <input
          placeholder="your@address.com"
          class="flex-1 min-w-0 bg-transparent px-3 py-3 text-sm placeholder:text-muted-foreground focus:outline-none mono-label"
          aria-label="Email address"
          type="email"
          required
        />
        <button
          type="submit"
          class="bg-foreground text-background px-5 micro-label hover:bg-accent transition-colors whitespace-nowrap"
        >
          Subscribe
        </button>
      </form>
      <p class="mono-label text-muted-foreground mt-3">
        Unsubscribe any time. No commerce in the letter.
      </p>
    </div>

    <!-- Index Links -->
    <div class="col-span-12 lg:col-span-3 hidden lg:block">
      <div class="micro-label text-muted-foreground mb-4">Index</div>
      <ul class="space-y-2">
        <li>
          <a class="text-sm hover:text-accent transition-colors" href="/catalog">Shop the catalogue</a>
        </li>
        <li>
          <a class="text-sm hover:text-accent transition-colors" href="/category/outerwear">All collections</a>
        </li>
        <li>
          <a class="text-sm hover:text-accent transition-colors" href="/catalog">Journal</a>
        </li>
        <li>
          <a class="text-sm hover:text-accent transition-colors" href="/account">Account dashboard</a>
        </li>
      </ul>
    </div>
  </div>

  <!-- Giant Typographic Wordmark -->
  <div class="border-t border-border overflow-hidden">
    <div class="px-6 pt-6 pb-2 flex items-end justify-center select-none">
      <a class="block leading-none" aria-label="Afetto home" href="/">
        <span class="block font-display font-normal text-foreground tracking-tight leading-[0.82] text-[clamp(80px,16vw,240px)]">
          Afetto.
        </span>
      </a>
    </div>
  </div>

  <!-- Bottom Legal Strip -->
  <div class="border-t border-border px-6 py-5 flex flex-col sm:flex-row items-center justify-between gap-3">
    <p class="mono-label text-muted-foreground">
      © Afetto Studio {currentYear} / Rua de Cedofeita 184, Porto
    </p>
    <p class="mono-label text-muted-foreground">
      Designed in Porto / Made in EU + JP
    </p>
  </div>
</footer>
