---
import Layout from '@/layouts/Layout.astro';
import { getProducts, getCategories } from '@/lib/api';
import { ProductCard } from '@/components/catalog/ProductCard';
import { ArrowRight, ShieldCheck, Truck, Sparkles, RefreshCw } from 'lucide-react';

const products = await getProducts();
const categories = await getCategories();
const featuredProducts = products.filter((p) => p.isFeatured).slice(0, 4);
---

<Layout title="Affeto — Minimalist Apparel & Everyday Essentials">
  <!-- Hero Section -->
  <section class="relative min-h-[85vh] flex items-center justify-center bg-zinc-900 text-zinc-50 overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?auto=format&fit=crop&w=2000&q=85"
        alt="Affeto Collection"
        class="w-full h-full object-cover object-center opacity-60 filter brightness-90"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-background via-transparent to-black/30"></div>
    </div>

    <div class="relative z-10 max-w-4xl mx-auto text-center px-4 sm:px-6 lg:px-8 py-20 space-y-6">
      <span class="inline-block text-xs uppercase tracking-[0.3em] font-semibold text-zinc-300">
        Autumn / Winter 2026 Collection
      </span>
      <h1 class="font-editorial text-4xl sm:text-6xl lg:text-7xl font-bold tracking-tight text-white leading-tight">
        Form Follows Quiet Function.
      </h1>
      <p class="text-base sm:text-lg text-zinc-300 max-w-2xl mx-auto font-light leading-relaxed">
        Thoughtfully engineered essentials crafted from pure linen, merino wool, and vintage-shuttle selvedge denim.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 pt-4">
        <a
          href="/catalog"
          class="bg-white text-zinc-900 hover:bg-zinc-100 px-8 py-3.5 rounded-md font-semibold text-xs uppercase tracking-widest transition-all transform hover:scale-105 shadow-xl"
        >
          Explore Catalog
        </a>
        <a
          href="/category/outerwear"
          class="border border-white/40 hover:border-white text-white px-8 py-3.5 rounded-md font-semibold text-xs uppercase tracking-widest transition-all backdrop-blur-xs"
        >
          View Outerwear
        </a>
      </div>
    </div>
  </section>

  <!-- Value Props -->
  <section class="border-b border-border bg-card/60 py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div class="flex flex-col items-center gap-2">
          <Truck class="w-5 h-5 text-primary stroke-1" />
          <span class="text-xs font-semibold text-foreground">Global Delivery</span>
          <span class="text-[11px] text-muted-foreground">Free on orders &gt; $100</span>
        </div>
        <div class="flex flex-col items-center gap-2">
          <Sparkles class="w-5 h-5 text-primary stroke-1" />
          <span class="text-xs font-semibold text-foreground">Artisan Materials</span>
          <span class="text-[11px] text-muted-foreground">Organic linen & wool</span>
        </div>
        <div class="flex flex-col items-center gap-2">
          <RefreshCw class="w-5 h-5 text-primary stroke-1" />
          <span class="text-xs font-semibold text-foreground">30-Day Guarantee</span>
          <span class="text-[11px] text-muted-foreground">Complimentary returns</span>
        </div>
        <div class="flex flex-col items-center gap-2">
          <ShieldCheck class="w-5 h-5 text-primary stroke-1" />
          <span class="text-xs font-semibold text-foreground">Stripe Verified</span>
          <span class="text-[11px] text-muted-foreground">256-bit encrypted checkout</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Collection -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4 mb-10">
      <div>
        <span class="text-xs uppercase tracking-widest font-semibold text-muted-foreground">Selected Pieces</span>
        <h2 class="font-editorial text-3xl sm:text-4xl font-bold tracking-tight text-foreground mt-1">
          Featured Essentials
        </h2>
      </div>
      <a href="/catalog" class="text-xs font-semibold uppercase tracking-wider text-primary flex items-center gap-1 hover:underline">
        <span>View Full Catalog</span>
        <ArrowRight class="w-3.5 h-3.5" />
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {featuredProducts.map((product) => (
        <ProductCard client:visible product={product} />
      ))}
    </div>
  </section>

  <!-- Categories Grid -->
  <section class="bg-secondary/40 py-20 border-y border-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-xl mx-auto mb-12 space-y-2">
        <span class="text-xs uppercase tracking-widest font-semibold text-muted-foreground">Categories</span>
        <h2 class="font-editorial text-3xl sm:text-4xl font-bold tracking-tight">Curated By Wardrobe Role</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <a href="/category/tops" class="group relative aspect-[4/5] rounded-xl overflow-hidden shadow-sm">
          <img
            src="https://images.unsplash.com/photo-1596755094514-f87e34085b2c?auto=format&fit=crop&w=1000&q=80"
            alt="Tops & Shirts"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent flex flex-col justify-end p-6 text-white">
            <h3 class="font-editorial text-2xl font-bold">Tops & Shirts</h3>
            <p class="text-xs text-zinc-300 mt-1">Pure French linen and merino knits</p>
          </div>
        </a>

        <a href="/category/bottoms" class="group relative aspect-[4/5] rounded-xl overflow-hidden shadow-sm">
          <img
            src="https://images.unsplash.com/photo-1542272604-780c96856592?auto=format&fit=crop&w=1000&q=80"
            alt="Bottoms & Denim"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent flex flex-col justify-end p-6 text-white">
            <h3 class="font-editorial text-2xl font-bold">Bottoms & Denim</h3>
            <p class="text-xs text-zinc-300 mt-1">14oz Japanese shuttle-loom selvedge</p>
          </div>
        </a>

        <a href="/category/outerwear" class="group relative aspect-[4/5] rounded-xl overflow-hidden shadow-sm">
          <img
            src="https://images.unsplash.com/photo-1544923246-77307dd654cb?auto=format&fit=crop&w=1000&q=80"
            alt="Outerwear"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent flex flex-col justify-end p-6 text-white">
            <h3 class="font-editorial text-2xl font-bold">Outerwear</h3>
            <p class="text-xs text-zinc-300 mt-1">Bonded canvas and stormproof coats</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Editorial Story Section -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="space-y-6">
        <span class="text-xs uppercase tracking-widest font-semibold text-muted-foreground">The Affeto Philosophy</span>
        <h2 class="font-editorial text-3xl sm:text-5xl font-bold tracking-tight leading-tight">
          Uncompromised Craft. Conscious Simplicity.
        </h2>
        <p class="text-sm text-foreground/80 leading-relaxed">
          We reject the accelerated churn of fast fashion in favor of permanence. Every seam, natural horn button, and selvage edge is considered for lasting comfort and organic aging.
        </p>
        <p class="text-sm text-foreground/80 leading-relaxed">
          By unifying our catalog, real-time inventory, and multi-currency transactions under Strapi headless architecture, we offer a modern, seamless digital shopping experience with zero compromises.
        </p>
        <div class="pt-2">
          <a href="/catalog" class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-primary hover:underline">
            <span>Discover The Entire Roster</span>
            <ArrowRight class="w-4 h-4" />
          </a>
        </div>
      </div>

      <div class="aspect-[4/3] rounded-xl overflow-hidden bg-muted shadow-md">
        <img
          src="https://images.unsplash.com/photo-1441986300917-64674bd600d8?auto=format&fit=crop&w=1200&q=80"
          alt="Studio Workshop"
          class="w-full h-full object-cover"
        />
      </div>
    </div>
  </section>
</Layout>
