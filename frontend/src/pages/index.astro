---
import Layout from "@/layouts/Layout.astro";
import { getProducts, getCategories } from "@/lib/api";
import HeroSection from "@/components/sections/HeroSection.astro";
import { ProductGridSection } from "@/components/sections/ProductGridSection";
import PhilosophySection from "@/components/sections/PhilosophySection.astro";
import LookbookSection from "@/components/sections/LookbookSection.astro";
import CollectionsTeaser from "@/components/sections/CollectionsTeaser.astro";
import ArchitecturalCollage from "@/components/sections/ArchitecturalCollage.astro";

const products = await getProducts();
const categories = await getCategories();
---

<Layout title="Afetto — Avant-garde Editorial Wardrobe">
  <!-- 00 / Hero Section with Real Categories & Counts -->
  <HeroSection products={products} categories={categories} />

  <!-- 01 / New Arrivals Product Grid with Real Products & Category Filters -->
  <ProductGridSection client:load products={products} categories={categories} />

  <!-- 02 / Philosophy Statement -->
  <PhilosophySection />

  <!-- 03 / Lookbook Feature with Real Garments -->
  <LookbookSection products={products} />

  <!-- 04 / Collections Teaser with Real Categories -->
  <CollectionsTeaser categories={categories} />

  <!-- 05 / Reference & Architectural Collage -->
  <ArchitecturalCollage />
</Layout>
