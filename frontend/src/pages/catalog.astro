---
import Layout from '@/layouts/Layout.astro';
import { getProducts, getCategories } from '@/lib/api';
import { CatalogExplorer } from '@/components/catalog/CatalogExplorer';

export const prerender = false;

const products = await getProducts();
const categories = await getCategories();

const search = Astro.url.searchParams.get('search') || '';
const category = Astro.url.searchParams.get('category') || '';
---

<Layout title="Catalogue — Afetto Wardrobe">
  <div class="px-6 py-12 lg:py-16 border-b border-border">
    <div class="space-y-3 max-w-2xl">
      <span class="mono-label text-muted-foreground">Index / All Objects</span>
      <h1 class="editorial-headline text-[clamp(40px,6vw,84px)] text-foreground">
        The Library<span class="text-accent">.</span>
      </h1>
      <p class="text-sm text-foreground leading-relaxed">
        A slow library cut from Portuguese loopback, Italian flannel, and Japanese washed canvas. All pieces designed in Porto.
      </p>
    </div>
  </div>

  <div class="px-6 py-8">
    <CatalogExplorer
      client:load
      initialProducts={products}
      categories={categories}
      initialCategory={category}
      initialSearch={search}
    />
  </div>
</Layout>
