---
import Layout from '@/layouts/Layout.astro';
import { fetcher } from '@/lib/api';
import { formatPrice } from '@/lib/utils';
import { CheckCircle, Package, ArrowRight, Printer } from 'lucide-react';
import type { Order } from '@/types';

const orderNumber = Astro.url.searchParams.get('orderNumber') || '';
const isMock = Astro.url.searchParams.get('mock') === 'true';

let order: Order | null = null;
let error = '';

if (orderNumber) {
  try {
    // If it's a mock completion, call Strapi to confirm order & decrement inventory
    if (isMock) {
      await fetcher('/api/checkout/confirm-mock', {
        method: 'POST',
        body: JSON.stringify({ orderNumber }),
      });
    }

    const res = await fetcher<{ data: Order }>(`/api/orders/${orderNumber}`);
    order = res.data;
  } catch (err: any) {
    error = err.message || 'Could not find order';
  }
}
---

<Layout title="Order Confirmed — Affeto">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    {order ? (
      <div class="bg-card rounded-2xl border border-border p-8 sm:p-12 shadow-sm space-y-8">
        <!-- Success Header -->
        <div class="text-center space-y-3">
          <div class="w-16 h-16 bg-emerald-100 text-emerald-700 rounded-full flex items-center justify-center mx-auto">
            <CheckCircle class="w-8 h-8" />
          </div>
          <span class="text-xs uppercase tracking-widest font-semibold text-emerald-700">Payment Successful</span>
          <h1 class="font-editorial text-3xl sm:text-4xl font-bold tracking-tight text-foreground">
            Thank You for Your Order
          </h1>
          <p class="text-xs sm:text-sm text-muted-foreground">
            Order confirmation and delivery tracking sent to <strong class="text-foreground">{order.customerEmail}</strong>.
          </p>
          <div class="inline-block bg-secondary px-4 py-1.5 rounded-full text-xs font-mono font-bold mt-2">
            Order #{order.orderNumber}
          </div>
        </div>

        <hr class="border-border" />

        <!-- Order Items Breakdown -->
        <div class="space-y-4">
          <h3 class="font-editorial text-lg font-bold">Purchased Items</h3>
          <div class="divide-y divide-border">
            {order.items?.map((item) => (
              <div class="py-3.5 flex items-center justify-between gap-4 text-xs">
                <div class="flex items-center gap-3">
                  <img
                    src={item.imageUrl || 'https://images.unsplash.com/photo-1596755094514-f87e34085b2c?auto=format&fit=crop&w=150&q=80'}
                    alt={item.productName}
                    class="w-12 h-14 object-cover rounded bg-muted flex-shrink-0"
                  />
                  <div>
                    <h4 class="font-semibold text-foreground">{item.productName}</h4>
                    <p class="text-muted-foreground">{item.variantTitle} • SKU: {item.sku}</p>
                    <p class="text-muted-foreground">Quantity: {item.quantity}</p>
                  </div>
                </div>
                <span class="font-semibold text-foreground">
                  {formatPrice(item.totalPrice, order.currency)}
                </span>
              </div>
            ))}
          </div>
        </div>

        <!-- Totals & Shipping Destination -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-4 border-t border-border text-xs">
          <div class="space-y-1 text-muted-foreground">
            <h4 class="font-semibold text-foreground uppercase tracking-wider text-[11px]">Shipping Destination</h4>
            <p class="text-foreground">{order.shippingAddress?.name}</p>
            <p>{order.shippingAddress?.street}</p>
            <p>{order.shippingAddress?.city}, {order.shippingAddress?.state} {order.shippingAddress?.postalCode}</p>
            <p>{order.shippingAddress?.country}</p>
          </div>

          <div class="space-y-2 text-muted-foreground sm:text-right">
            <div class="flex justify-between sm:justify-end gap-4">
              <span>Subtotal:</span>
              <span class="text-foreground font-medium">{formatPrice(order.subtotal, order.currency)}</span>
            </div>
            {order.discountAmount > 0 && (
              <div class="flex justify-between sm:justify-end gap-4 text-emerald-700">
                <span>Discount:</span>
                <span>-{formatPrice(order.discountAmount, order.currency)}</span>
              </div>
            )}
            <div class="flex justify-between sm:justify-end gap-4">
              <span>Shipping:</span>
              <span>{order.shippingAmount === 0 ? 'FREE' : formatPrice(order.shippingAmount, order.currency)}</span>
            </div>
            <div class="flex justify-between sm:justify-end gap-4 text-sm font-bold text-foreground pt-2 border-t border-border">
              <span>Total Paid:</span>
              <span class="font-editorial text-base">{formatPrice(order.totalAmount, order.currency)}</span>
            </div>
          </div>
        </div>

        <!-- Actions -->
        <div class="pt-6 border-t border-border flex flex-wrap items-center justify-between gap-4">
          <button
            onclick="window.print()"
            class="inline-flex items-center gap-2 text-xs font-semibold text-muted-foreground hover:text-foreground border border-border px-4 py-2.5 rounded-md"
          >
            <Printer class="w-4 h-4" />
            <span>Print Receipt</span>
          </button>

          <a
            href="/catalog"
            class="inline-flex items-center gap-2 bg-primary text-primary-foreground px-6 py-2.5 rounded-md text-xs font-semibold uppercase tracking-wider hover:bg-primary/90 transition-colors shadow-sm"
          >
            <span>Continue Shopping</span>
            <ArrowRight class="w-4 h-4" />
          </a>
        </div>
      </div>
    ) : (
      <div class="bg-card rounded-2xl border border-border p-12 text-center space-y-4">
        <Package class="w-12 h-12 text-muted-foreground mx-auto stroke-1" />
        <h2 class="font-editorial text-2xl font-bold">Order Not Found</h2>
        <p class="text-xs text-muted-foreground">{error || 'Please check your order confirmation email.'}</p>
        <a href="/catalog" class="inline-block bg-primary text-primary-foreground px-6 py-2 rounded-md text-xs font-semibold">
          Return to Catalog
        </a>
      </div>
    )}
  </div>
</Layout>
