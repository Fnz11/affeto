{
  "kind": "collectionType",
  "collectionName": "variants",
  "info": {
    "singularName": "variant",
    "pluralName": "variants",
    "displayName": "Variant",
    "description": "Product variants (size, color, SKU)"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "sku": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "size": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "colorHex": {
      "type": "string"
    },
    "weight": {
      "type": "decimal"
    },
    "image": {
      "type": "string"
    },
    "product": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product.product",
      "inversedBy": "variants"
    },
    "inventory": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::inventory.inventory",
      "inversedBy": "variant"
    },
    "prices": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::price.price",
      "mappedBy": "variant"
    }
  }
}
