{
  "kind": "collectionType",
  "collectionName": "prices",
  "info": {
    "singularName": "price",
    "pluralName": "prices",
    "displayName": "Price",
    "description": "Multi-currency prices in minor units (cents)"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "currency": {
      "type": "enumeration",
      "enum": ["USD", "EUR", "GBP"],
      "required": true,
      "default": "USD"
    },
    "amount": {
      "type": "integer",
      "required": true,
      "description": "Price in minor units (e.g. 2999 = $29.99)"
    },
    "compareAtAmount": {
      "type": "integer",
      "description": "Original strike-through price in minor units"
    },
    "variant": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::variant.variant",
      "inversedBy": "prices"
    }
  }
}
