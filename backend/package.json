{
  "name": "affeto-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Strapi Headless E-Commerce Backend",
  "scripts": {
    "dev": "strapi develop",
    "develop": "strapi develop",
    "start": "strapi start",
    "build": "strapi build && bun -e \"const fs = require('fs'); fs.cpSync('src', 'dist/src', { recursive: true, filter: (s) => !s.endsWith('.ts') && !s.endsWith('.tsx') });\"",
    "strapi": "strapi",
    "seed": "bun run scripts/seed.ts"
  },
  "dependencies": {
    "@strapi/plugin-cloud": "^5.0.0",
    "@strapi/plugin-users-permissions": "^5.0.0",
    "@strapi/strapi": "^5.0.0",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "stripe": "^17.7.0",
    "styled-components": "^6.1.13"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.1",
    "@types/pg": "^8.11.11",
    "typescript": "^5.7.3"
  },
  "license": "MIT"
}
